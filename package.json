{
  "name": "lo-cheoio",
  "private": true,
  "version": "1.1.8",
  "description": "Lọ Chéo — Hũ Dưa Đại Chiến: arcade muối dưa chạy 100% trong trình duyệt, gói gọn trong một file HTML duy nhất, offline-first — không CDN, không server. Chiếc lọ gốm chỉ chịu đi đường CHÉO: giữ 2 phím để lượn xiên, tăng tốc chém tan mốc, ruồi, sâu rau, hứng đầy hũ trước khi gốm nứt làm ba. 9 chế độ chơi, 14 nguyên liệu, 16 thành tựu, bảng vàng TOP 8, giao diện 7 ngôn ngữ.",
  "author": "Standardize Paradigm <standardizeparadigm@donuco.com>",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://github.com/standardizeparadigm/LoCheoIO",
  "repository": {
    "type": "git",
    "url": "https://github.com/standardizeparadigm/LoCheoIO.git"
  },
  "bugs": {
    "url": "https://github.com/standardizeparadigm/LoCheoIO/issues"
  },
  "keywords": [
    "lo-cheo",
    "hũ-dưa-đại-chiến",
    "arcade",
    "html5-canvas",
    "react",
    "vite",
    "browser-game",
    "offline-first",
    "indie-game",
    "vietnamese-game",
    "game",
    "time-attack",
    "gold-rush",
    "blitz",
    "storm",
    "hardcore",
    "combo",
    "feast",
    "pickle-rain",
    "japanese",
    "korean",
    "spanish",
    "french"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && node scripts/check-svg.mjs && vite-node scripts/check-adaptive.ts && vite-node scripts/audit-adaptive.ts --check && vite-node scripts/audit-drag.ts --check && vite build",
    "smoke": "vite-node scripts/smoke-ssr.tsx",
    "check:readme": "node scripts/check-readme-sync.mjs && node scripts/sync-test-badge.mjs --verify && node scripts/sync-prose-counts.mjs --verify",
    "sync:badge": "node scripts/sync-test-badge.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "gen:chip": "vite-node scripts/gen-mode-chip-fixtures.ts",
    "gen:regress": "vite-node scripts/gen-regression-fixtures.ts",
    "gen:select": "vite-node scripts/gen-selection-fixtures.ts",
    "check:adaptive": "vite-node scripts/check-adaptive.ts",
    "audit:adaptive": "vite-node scripts/audit-adaptive.ts",
    "check:svg": "node scripts/check-svg.mjs",
    "audit:drag": "vite-node scripts/audit-drag.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "^3.2.7"
  }
}
